# Copy to .env.local and fill in what you use. Everything is optional:
# with no settings at all, the app runs on an embedded database in .data/.

# ── Database (Supabase) ────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# App runtime: transaction pooler (port 6543).
DATABASE_URL=
# Migrations: session pooler or direct connection (port 5432).
DATABASE_URL_DIRECT=
# Max connections the app opens (default 5).
# DATABASE_POOL_MAX=5

# ── Google Calendar ────────────────────────────────────────────────────────
# Google Cloud Console → OAuth client (Web). Redirect URI:
#   http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (Claude) ────────────────────────────────────────────────────────────
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# ── Other ──────────────────────────────────────────────────────────────────
# Where the embedded database lives when DATABASE_URL is empty (default .data/pglite)
# LOCAL_DB_DIR=.data/pglite

# ── Online hosting (Vercel etc.) ───────────────────────────────────────────
# Required when the app is reachable from the internet: the password to open it.
APP_PASSWORD=
# Optional: any random string; changing it signs out every device.
# AUTH_SECRET=
# Your time zone — hosting runs on UTC, this keeps "today" right. e.g. Europe/Berlin
APP_TIMEZONE=
